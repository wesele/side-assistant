<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_mic_toggle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal|top"
    android:paddingTop="12dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 匹配 SA App 图标尺寸与圆角的 Squircle 容器 -->
    <FrameLayout
        android:id="@+id/widget_card_container"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/widget_card_squircle">

        <!-- 监听激活状态下的柔和底晕 -->
        <ImageView
            android:id="@+id/widget_mic_halo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_halo_active"
            android:visibility="gone" />

        <!-- 居中麦克风主图标 -->
        <ImageView
            android:id="@+id/widget_mic_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_mic_inactive" />
    </FrameLayout>

    <!-- 底部状态小灯条（宽度为图标一半 26dp，浅绿表示后台存活 / 灰色表示未存活） -->
    <ImageView
        android:id="@+id/widget_light_bar"
        android:layout_width="26dp"
        android:layout_height="2.5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bar_offline" />

</LinearLayout>
